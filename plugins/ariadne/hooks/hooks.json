{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/ariadne\" hook user-prompt-submit" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|Bash",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/ariadne\" hook pre-tool-use" }
        ]
      },
      {
        "matcher": "SubagentHandback",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/ariadne\" hook pre-tool-use", "timeout": 1200, "statusMessage": "Ariadne: checking the subagent's lint, complexity and tests" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|Bash",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/ariadne\" hook post-tool-use" }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/ariadne\" hook post-tool-use" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/ariadne\" hook stop", "timeout": 1200, "statusMessage": "Ariadne: checking lint, complexity and tests (this can take a few minutes)" }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/ariadne\" hook subagent-start" }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/ariadne\" hook subagent-stop", "timeout": 1200, "statusMessage": "Ariadne: checking the subagent's lint, complexity and tests" }
        ]
      }
    ]
  }
}
